<?xml version="1.0"?>
<psalm
        resolveFromConfigFile="true"
        phpVersion="8.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://getpsalm.org/schema/config"
        xsi:schemaLocation="https://getpsalm.org/schema/config https://raw.githubusercontent.com/vimeo/psalm/6.x/config.xsd"
        allowStringToStandInForClass="true"
        findUnusedCode="false"
        findUnusedBaselineEntry="true"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests/"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <fileExtensions>
        <extension name=".php"/>
    </fileExtensions>

    <issueHandlers>
        <InvalidReturnType>
            <errorLevel type="suppress">
                <directory name="tests/"/>
            </errorLevel>
        </InvalidReturnType>

        <!-- This hides a number of errors that we don't really care about. -->
        <PropertyNotSetInConstructor errorLevel="suppress"/>

        <!-- #[Override] needs PHP 8.3; the library supports 8.0. -->
        <MissingOverrideAttribute errorLevel="suppress"/>
    </issueHandlers>
</psalm>
